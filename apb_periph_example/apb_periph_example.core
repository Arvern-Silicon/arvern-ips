name: arvern:ips:apb_periph_example:1.0.0
description: APB4 peripheral example -- 8 read-write and 8 read-only registers with a privilege-gated MDELEG register; the template for APB completers behind ahb_apb_bridge.

filesets:
  rtl:
    file_type: verilogSource
    files:
      - rtl/verilog/apb_periph_example.v
    depend:
      - arvern:ips:arv_primitives:1.0.0

targets:
  default: &default
    filesets: [rtl]

  lint:
    <<: *default
    flow: lint
    flow_options: {tool: verilator}
    toplevel: apb_periph_example
