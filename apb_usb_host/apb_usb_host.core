# ----------------------------------------------------------------------------
# FuseSoC manifest for external integration — see ahb_rom_controller.core
# for the usage pattern.  Native sim flow is under sim/rtl_sim/.
# ----------------------------------------------------------------------------

name: arvern:ips:apb_usb_host:1.0.0
description: APB4 low-speed USB host for one HID device, with hardware enumeration and raw report delivery.

filesets:
  rtl:
    file_type: verilogSource
    files:
      - rtl/verilog/apb_usb_host_sie.v
      - rtl/verilog/apb_usb_host_seq.v
      - rtl/verilog/apb_usb_host.v
    depend:
      - arvern:ips:arv_primitives:1.0.0

  lint_waivers:
    files:
      - sim/rtl_sim/run/waivers.vlt: {file_type: vlt}

targets:
  default: &default
    filesets: [rtl]

  lint:
    filesets: [rtl, lint_waivers]
    flow: lint
    flow_options: {tool: verilator}
    toplevel: apb_usb_host
