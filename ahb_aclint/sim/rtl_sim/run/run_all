#!/bin/bash

# -sweep : run the parameterization sweep (every test under every
#          compatible config defined in bin/sim_configs.py). Each
#          (config, test) gets its own iverilog compile with -D
#          PLIC_* / ACLINT_* defines.
if [ "$1" = "-sweep" ]; then
    exec ../bin/run_sweep.py
fi
if [ "$1" = "-cov" ]; then
    exec ../bin/runcov
fi

# Disable waveform dumping
SIMULATION_NODUMP=1
export SIMULATION_NODUMP

# Choose simulator:
#                   - iverilog  : Icarus Verilog  (default)
#                   - cver      : CVer
#                   - verilog   : Verilog-XL
#                   - ncverilog : NC-Verilog
#                   - vcs       : VCS
#                   - vsim      : Modelsim
#                   - isim      : Xilinx simulator
VERILOG_SIMULATOR=iverilog
export VERILOG_SIMULATOR


# Read the default-config test list once, up front. An empty list here would
# make the regression "pass" without running anything, so it is a hard error.
TESTS=$(python3 -c "import sys; sys.path.insert(0,'../bin'); from sim_configs import DEFAULT_TESTS; print(' '.join(DEFAULT_TESTS))" 2>&1)
if [ $? -ne 0 ] || [ -z "$TESTS" ]; then
    echo "ERROR: could not read DEFAULT_TESTS from ../bin/sim_configs.py"
    echo "$TESTS"
    exit 1
fi
echo "Running $(echo $TESTS | wc -w | tr -d ' ') tests from bin/sim_configs.py DEFAULT_TESTS"

# Argument specifies number of regression loops
if [ $# -ne 1 ]; then
    LAST_REGRESSION=0
else
    LAST_REGRESSION=$(($1-1))
fi

# Cleanup from previous regression
LOG_DIR=./log
rm -rf $LOG_DIR/*

# Perform the regression runs
for (( ii=0; ii<=$LAST_REGRESSION; ii++ ))
  do

    # Cleanup & log directory setup
    LOG_DIR=./log/$ii
    mkdir -p $LOG_DIR

    # Test list comes from bin/sim_configs.py (DEFAULT_TESTS), the same source
    # run_sweep.py uses. Do NOT hardcode it here: a duplicated list drifts, and a
    # regression that silently runs a subset still prints a confident PASS.
    for tt in $TESTS; do
        ../bin/runsim $tt                     | tee $LOG_DIR/$tt.log
    done

    # Report regression results
    ../bin/parse_results $LOG_DIR             | tee $LOG_DIR/../summary.$ii.log

    # Functional coverage for this (single-config) run. Reported, not gated:
    # some mandatory bins need a parameterization only the sweep builds.
    ../bin/cov_report $LOG_DIR                | tee -a $LOG_DIR/../summary.$ii.log

done


if [ $LAST_REGRESSION != 0 ]; then
    ../bin/parse_summaries                    | tee $LOG_DIR/../regressions_summary.log
fi
