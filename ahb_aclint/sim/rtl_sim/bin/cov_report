# Functional-coverage report for a SINGLE-config regression (bare run_all).
#
#   cov_report <log_dir>
#
# Reports, and fails only on bins the default config can actually reach --
# SWEEP_ONLY_COVER_BINS are listed as expected-absent. The gate with teeth is
# run_all -sweep, which runs the configs that reach them.
#----------------------------------------------------------------------------
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import coverage                                            # noqa: E402

if len(sys.argv) != 2:
    sys.exit("usage: cov_report <log_dir>")

log_dir = Path(sys.argv[1])
if not log_dir.is_dir():
    sys.exit(f"cov_report: no such log directory: {log_dir}")

sys.exit(1 if coverage.report(log_dir, single_config=True) else 0)
