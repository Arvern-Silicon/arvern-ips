# Full license text is available in the LICENSE file at the repository root.
#----------------------------------------------------------------------------
# File Name          : run_fused_sram
# Module Description : Run wrapper for the fused-SRAM testbench variant.
#----------------------------------------------------------------------------

VERILOG_SIMULATOR=${VERILOG_SIMULATOR:-iverilog}
SIMULATION_NODUMP=${SIMULATION_NODUMP:-0}

SUBMITFILE=../../../bench/verilog/submit_fused_sram.f

# ----- Parse arguments (currently only -seed N) ------------------------------
seed=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -seed)
            seed="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: $(basename "$0") [-seed N]"
            echo "  -seed N    Pin \$urandom seed for reproducibility."
            echo "             Without -seed, a fresh random seed is drawn"
            echo "             from /dev/urandom and printed at sim start."
            exit 0
            ;;
        *)
            echo "[WARN] Unknown argument: $1 (ignored)"
            shift
            ;;
    esac
done
if [ -z "$seed" ]; then
    seed=$(od -A n -t u4 -N 4 /dev/urandom | tr -d ' \n')
fi

echo " ======================================================="
echo "| Start simulation: ahb_fused_sram_ctrl unit testbench  |"
echo "| seed = $seed"
echo " ======================================================="
echo ""

rm -rf simv *.vcd

if [ "$VERILOG_SIMULATOR" = "iverilog" ]; then
    NODUMP_FLAG=""
    [ "$SIMULATION_NODUMP" -eq 1 ] && NODUMP_FLAG="-D NODUMP"

    # Flatten the submit filelist to absolute paths (Option-2 portable form).
    FLATTEN_PY="$(dirname "$(realpath "$0")")/../bin/flatten_filelist.py"
    "$FLATTEN_PY" "$SUBMITFILE" ./submit_sim.f >/dev/null
    SUBMITFILE=./submit_sim.f
if [ "$PASS_SEL" = "both" ] || [ "$PASS_SEL" = "rr" ]; then

    # ------------------------------------------------------------------------
    # Pass 1: round-robin (default arbitration)
    # ------------------------------------------------------------------------
    iverilog -o simv -c $SUBMITFILE $NODUMP_FLAG -D SEED=$seed
    if [ $? -ne 0 ]; then
        echo "[ERROR] RR compilation failed."
        exit 1
    fi
    ./simv
fi
if [ "$PASS_SEL" = "both" ] || [ "$PASS_SEL" = "fixb" ]; then

    # ------------------------------------------------------------------------
    # Pass 2: FIXED_B_PRIO=1 (fixed Port-B priority)
    #
    # This is the arbiter the documentation warns can starve instruction fetch,
    # and until now the unit bench could not even elaborate against it: the DUT
    # took no parameter and the bench reached into dut.gen_arb_rr, which does
    # not exist in the fixed branch. Tests that need both ports served fairly
    # are guarded out with `ifndef FUSED_FIXED_B_PRIO; the rest exercise the
    # fixed-B arbiter, and the Port-A wait bound is disabled because starving
    # A is this mode's documented behaviour.
    # ------------------------------------------------------------------------
    iverilog -o simv_fixb -c $SUBMITFILE $NODUMP_FLAG -D SEED=$seed -D FUSED_FIXED_B_PRIO
    if [ $? -ne 0 ]; then
        echo "[ERROR] Fixed-B compilation failed."
        exit 1
    fi
    ./simv_fixb
fi
else
    echo "ERROR: Only iverilog is supported by this script."
    exit 1
fi
