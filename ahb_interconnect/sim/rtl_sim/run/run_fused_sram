#!/bin/bash

# Optional pass selector so run_all can log each arbitration mode separately
# (parse_results scores a log by a single "PASSED" line, so the two passes
# must not share one log). No argument runs both, as before.
PASS_SEL="${1:-both}"

#----------------------------------------------------------------------------
#          _    _           Family:    aRVern System IPs
#         / \__/ \          Module:    run_fused_sram
#        /   /\   \         --------------------------------------------
#    ===/   /=========      Copyright: (c) 2026, aRVern-dev
