#!/bin/bash

if [ "${1:-}" = "-cov" ]; then
    exec ../bin/runcov
fi

# Disable waveform dumping
SIMULATION_NODUMP=1
export SIMULATION_NODUMP

# Choose simulator:
#                   - iverilog  : Icarus Verilog  (default)
#                   - cver      : CVer
#                   - verilog   : Verilog-XL
#                   - ncverilog : NC-Verilog
#                   - vcs       : VCS
#                   - vsim      : Modelsim
#                   - isim      : Xilinx simulator
VERILOG_SIMULATOR=iverilog
export VERILOG_SIMULATOR


# Argument specifies number of regression loops
if [ $# -ne 1 ]; then
    LAST_REGRESSION=0
else
    LAST_REGRESSION=$(($1-1))
fi

# Cleanup from previous regression
LOG_DIR=./log
rm -rf $LOG_DIR/*

# Perform the regression runs
for (( ii=0; ii<=$LAST_REGRESSION; ii++ ))
  do

    # Cleanup & log directory setup
    LOG_DIR=./log/$ii
    mkdir -p $LOG_DIR
     
    # Every test runs in three builds: the RTL defaults, synchronous reset
    # (ASYNC_RST_EN=0) and a wider window (ADDRW=8). Logs are <test>.log,
    # <test>-sync.log and <test>-addrw8.log, so ../bin/parse_results counts each
    # build as a separate test.
    TESTS="simple_rdwr pipelined_rdwr mdeleg_w_error mdeleg_wo_error mdeleg_no_alias \
           denied_unmapped_ro denied_narrow hsize_oversize bus_stall_hsel \
           burst_busy_seq error_hold reset_mid_transfer rw_data_walk \
           ro_input_walk addrw8_upper_window ro_writes_hprot mdeleg_lanes"
    for build in ":" "-sync:-D ASYNC_RST_EN=0" "-addrw8:-D ADDRW=8"; do
        suffix="${build%%:*}"
        SIM_EXTRA_DEFINES="${build#*:}"
        export SIM_EXTRA_DEFINES
        for t in $TESTS; do
            ../bin/runsim $t                  | tee $LOG_DIR/$t$suffix.log
        done
    done
    unset SIM_EXTRA_DEFINES


    # Report regression results
    ../bin/parse_results $LOG_DIR             | tee $LOG_DIR/../summary.$ii.log

done


if [ $LAST_REGRESSION != 0 ]; then
    ../bin/parse_summaries                    | tee $LOG_DIR/../regressions_summary.log
fi
