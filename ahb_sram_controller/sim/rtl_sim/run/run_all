#!/bin/bash

if [ "${1:-}" = "-cov" ]; then
    exec ../bin/runcov
fi

# Disable waveform dumping
SIMULATION_NODUMP=1
export SIMULATION_NODUMP

# Choose simulator:
#                   - iverilog  : Icarus Verilog  (default)
#                   - cver      : CVer
#                   - verilog   : Verilog-XL
#                   - ncverilog : NC-Verilog
#                   - vcs       : VCS
#                   - vsim      : Modelsim
#                   - isim      : Xilinx simulator
VERILOG_SIMULATOR=iverilog
export VERILOG_SIMULATOR


# Argument specifies number of regression loops
if [ $# -ne 1 ]; then
    LAST_REGRESSION=0
else
    LAST_REGRESSION=$(($1-1))
fi

# Cleanup from previous regression
LOG_DIR=./log
rm -rf $LOG_DIR/*

# Perform the regression runs
for (( ii=0; ii<=$LAST_REGRESSION; ii++ ))
  do

    # Cleanup & log directory setup
    LOG_DIR=./log/$ii
    mkdir -p $LOG_DIR
     
    # Every test in the default build, in synchronous reset (ASYNC_RST_EN=0) and
    # at a large SRAM (MEM_SIZE=65536). The minimum SRAM (MEM_SIZE=8, two words)
    # runs the tests whose checks hold under address aliasing. Logs are
    # <test><suffix>.log so ../bin/parse_results counts each build separately.
    TESTS="simple_rdwr pipelined_rdwr pipelined_advanced rpw_sequences foreign_aph \
           hready_stall busy_seq hsize_oversize reset_midtransfer illegal_state address_walk"
    SMALL_TESTS="rpw_sequences foreign_aph hready_stall busy_seq hsize_oversize reset_midtransfer illegal_state address_walk"
    for build in ":" "-sync:-D ASYNC_RST_EN=0" "-mem64k:-D MEM_SIZE=65536 -D VERY_LONG_TIMEOUT" "-mem8:-D MEM_SIZE=8"; do
        suffix="${build%%:*}"
        SIM_EXTRA_DEFINES="${build#*:}"
        export SIM_EXTRA_DEFINES
        list=$TESTS
        [ "$suffix" = "-mem8" ] && list=$SMALL_TESTS
        for t in $list; do
            ../bin/runsim $t                  | tee $LOG_DIR/$t$suffix.log
        done
    done
    unset SIM_EXTRA_DEFINES

    # Report regression results
    ../bin/parse_results $LOG_DIR             | tee $LOG_DIR/../summary.$ii.log

done


if [ $LAST_REGRESSION != 0 ]; then
    ../bin/parse_summaries                    | tee $LOG_DIR/../regressions_summary.log
fi
