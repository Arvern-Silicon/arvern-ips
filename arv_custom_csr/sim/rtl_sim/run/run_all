#!/bin/bash

if [ "${1:-}" = "-cov" ]; then
    exec ../bin/runcov
fi

# Disable waveform dumping
SIMULATION_NODUMP=1
export SIMULATION_NODUMP

# Choose simulator:
#                   - iverilog  : Icarus Verilog  (default)
#                   - cver      : CVer
#                   - verilog   : Verilog-XL
#                   - ncverilog : NC-Verilog
#                   - vcs       : VCS
#                   - vsim      : Modelsim
#                   - isim      : Xilinx simulator
VERILOG_SIMULATOR=iverilog
export VERILOG_SIMULATOR


# Argument specifies number of regression loops
if [ $# -ne 1 ]; then
    LAST_REGRESSION=0
else
    LAST_REGRESSION=$(($1-1))
fi

# Cleanup from previous regression
LOG_DIR=./log
rm -rf $LOG_DIR/*

# Perform the regression runs
for (( ii=0; ii<=$LAST_REGRESSION; ii++ ))
  do

    # Cleanup & log directory setup
    LOG_DIR=./log/$ii
    mkdir -p $LOG_DIR
     
    # Fixed-address tests: written for the bench's own configuration
    # (4/2/4/2/4/2), in both reset styles.
    FIXED_TESTS="simple_rdwr simple_rdonly supervisor_rdwr wen_zero"
    for build in ":" "-sync:-D ASYNC_RST_EN=0"; do
        suffix="${build%%:*}"
        SIM_EXTRA_DEFINES="${build#*:}"
        export SIM_EXTRA_DEFINES
        for t in $FIXED_TESTS; do
            ../bin/runsim $t                  | tee $LOG_DIR/$t$suffix.log
        done
    done

    # Configuration-independent tests: every config of ../bin/rtl_configs.py,
    # parameters not overridden by a config taking the RTL default. Logs are
    # <test>-<config>.log so ../bin/parse_results counts each build.
    SWEEP_TESTS="bank_map_sweep random_access reset_values register_walk"
    python3 ../bin/rtl_configs_defines.py | while IFS=: read -r label defines; do
        SIM_EXTRA_DEFINES="$defines"
        export SIM_EXTRA_DEFINES
        for t in $SWEEP_TESTS; do
            ../bin/runsim $t                  | tee $LOG_DIR/$t-$label.log
        done
    done
    unset SIM_EXTRA_DEFINES

    # Report regression results
    ../bin/parse_results $LOG_DIR             | tee $LOG_DIR/../summary.$ii.log

done


if [ $LAST_REGRESSION != 0 ]; then
    ../bin/parse_summaries                    | tee $LOG_DIR/../regressions_summary.log
fi
