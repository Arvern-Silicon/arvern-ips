{signal: [
  {name: 'clk_i (SoC osc)', wave: '0.........p.p.p.p.'},
  {},
  {name: 'TCKC (probe)',    wave: '0p.p.p.p.p.p.p.p.p.'},
  {name: 'dbg_wakeup_o',    wave: '01010101010101010.'},
  {},
  {name: 'SoC clk request', wave: '0..1..............'},
