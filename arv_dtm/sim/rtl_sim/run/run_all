#!/bin/bash

# Disable waveform dumping
SIMULATION_NODUMP=1
export SIMULATION_NODUMP

# Choose simulator (iverilog default)
VERILOG_SIMULATOR=iverilog
export VERILOG_SIMULATOR

# Args: [-sync_rst] [-cov] [loops]
#   -sync_rst : build the SYNCHRONOUS reset variant (ARST_EN=0) for every test. Without
#               it the sync-reset configuration is never exercised.
#   -cov      : line/branch/toggle coverage sweep instead of the regression. Needs
#               Verilator; the regression itself runs on Icarus, which cannot measure it.
RUNSIM_EXTRA=""
RST_MODE="async (ARST_EN=1)"
LOOPS=""
while [ $# -gt 0 ]; do
    case "$1" in
        -sync_rst) RUNSIM_EXTRA="-sync_rst"; RST_MODE="SYNC (ARST_EN=0)" ;;
        -cov)      exec ../bin/runcov ;;
        *)         LOOPS="$1" ;;
    esac
    shift
done
if [ -z "$LOOPS" ]; then
    LAST_REGRESSION=0
else
    LAST_REGRESSION=$(($LOOPS-1))
fi
RUNSIM="../bin/runsim $RUNSIM_EXTRA"
echo "| Reset mode: $RST_MODE"

# Cleanup from previous regression
LOG_DIR=./log
rm -rf $LOG_DIR/*

# Perform the regression runs
for (( ii=0; ii<=$LAST_REGRESSION; ii++ ))
  do

    # Cleanup & log directory setup
    LOG_DIR=./log/$ii
    mkdir -p $LOG_DIR

    # arv_dtm block-level test list
    # -- Generic DMI r/w (same stimulus over each transport) --
    $RUNSIM dmi_rdwr -dtm jtag               | tee $LOG_DIR/dmi_rdwr_jtag.log
    $RUNSIM dmi_rdwr -dtm uart               | tee $LOG_DIR/dmi_rdwr_uart.log
    $RUNSIM dmi_rdwr -dtm i2c                | tee $LOG_DIR/dmi_rdwr_i2c.log
    $RUNSIM dmi_rdwr -dtm cjtag              | tee $LOG_DIR/dmi_rdwr_cjtag.log
    $RUNSIM cjtag_escape_park -dtm cjtag     | tee $LOG_DIR/cjtag_escape_park.log
    $RUNSIM cjtag_escape_boundary -dtm cjtag | tee $LOG_DIR/cjtag_escape_boundary.log
    $RUNSIM cjtag_por_act -dtm cjtag         | tee $LOG_DIR/cjtag_por_act.log
    $RUNSIM cjtag_act_cp_nop -dtm cjtag      | tee $LOG_DIR/cjtag_act_cp_nop.log
    $RUNSIM cjtag_act_cp_rso -dtm cjtag      | tee $LOG_DIR/cjtag_act_cp_rso.log
    $RUNSIM cjtag_act_long -dtm cjtag        | tee $LOG_DIR/cjtag_act_long.log
    $RUNSIM cjtag_escape_align -dtm cjtag    | tee $LOG_DIR/cjtag_escape_align.log
    $RUNSIM cjtag_cold_attach -dtm cjtag     | tee $LOG_DIR/cjtag_cold_attach.log
    $RUNSIM cjtag_reset_assert -dtm cjtag    | tee $LOG_DIR/cjtag_reset_assert.log
    $RUNSIM cjtag_escape_reset_high -dtm cjtag | tee $LOG_DIR/cjtag_escape_reset_high.log
    $RUNSIM cjtag_scan_mode -dtm cjtag        | tee $LOG_DIR/cjtag_scan_mode.log
    $RUNSIM cjtag_escape_saturate -dtm cjtag  | tee $LOG_DIR/cjtag_escape_saturate.log
    $RUNSIM jtag_ir_unassigned -dtm jtag      | tee $LOG_DIR/jtag_ir_unassigned.log
    $RUNSIM dmi_walk -dtm jtag                | tee $LOG_DIR/dmi_walk_jtag.log
    $RUNSIM dmi_walk -dtm uart                | tee $LOG_DIR/dmi_walk_uart.log
    $RUNSIM dmi_walk -dtm i2c                 | tee $LOG_DIR/dmi_walk_i2c.log
    $RUNSIM dmi_walk -dtm cjtag               | tee $LOG_DIR/dmi_walk_cjtag.log
    $RUNSIM uart_ferr_ahead_queued -dtm uart  | tee $LOG_DIR/uart_ferr_ahead_queued.log
    $RUNSIM i2c_read_addr_stop -dtm i2c       | tee $LOG_DIR/i2c_read_addr_stop.log
    $RUNSIM cjtag_first_packet -dtm cjtag    | tee $LOG_DIR/cjtag_first_packet.log
    $RUNSIM cjtag_bad_actcode -dtm cjtag     | tee $LOG_DIR/cjtag_bad_actcode.log
    $RUNSIM cjtag_bad_scnfmt -dtm cjtag      | tee $LOG_DIR/cjtag_bad_scnfmt.log
    $RUNSIM cjtag_escape_5edge -dtm cjtag    | tee $LOG_DIR/cjtag_escape_5edge.log
    $RUNSIM cjtag_escape_inflight -dtm cjtag | tee $LOG_DIR/cjtag_escape_inflight.log
    # -- JTAG-specific --
    $RUNSIM idcode_bypass                    | tee $LOG_DIR/idcode_bypass.log
    $RUNSIM idcode_alt                       | tee $LOG_DIR/idcode_alt.log
    $RUNSIM jtag_no_trst                     | tee $LOG_DIR/jtag_no_trst.log
    $RUNSIM dtmcs_fields                     | tee $LOG_DIR/dtmcs_fields.log
    $RUNSIM dtmcs_errinfo                    | tee $LOG_DIR/dtmcs_errinfo.log
    $RUNSIM dmi_busy_recover                 | tee $LOG_DIR/dmi_busy_recover.log
    $RUNSIM dmi_busy_secondary               | tee $LOG_DIR/dmi_busy_secondary.log
    $RUNSIM jtag_first_tck                   | tee $LOG_DIR/jtag_first_tck.log
    $RUNSIM jtag_pause_resume                | tee $LOG_DIR/jtag_pause_resume.log
    $RUNSIM jtag_idle_hint                   | tee $LOG_DIR/jtag_idle_hint.log
    $RUNSIM dmi_hardreset                    | tee $LOG_DIR/dmi_hardreset.log
    $RUNSIM dmi_hardreset_abort              | tee $LOG_DIR/dmi_hardreset_abort.log
    $RUNSIM dmi_status_recover               | tee $LOG_DIR/dmi_status_recover.log
    $RUNSIM dmi_capture_addr                 | tee $LOG_DIR/dmi_capture_addr.log
    $RUNSIM dmi_capture_addr -dtm cjtag      | tee $LOG_DIR/dmi_capture_addr_cjtag.log
    $RUNSIM dmi_reset_cross                  | tee $LOG_DIR/dmi_reset_cross.log
    $RUNSIM dmi_fail_capture_sweep           | tee $LOG_DIR/dmi_fail_capture_sweep.log
    $RUNSIM dmi_fail_capture_sweep -dtm cjtag | tee $LOG_DIR/dmi_fail_capture_sweep_cjtag.log
    $RUNSIM dmi_fail_behind_busy             | tee $LOG_DIR/dmi_fail_behind_busy.log
    $RUNSIM dmi_fail_behind_busy -dtm cjtag  | tee $LOG_DIR/dmi_fail_behind_busy_cjtag.log
    $RUNSIM dmi_probe_reset_access           | tee $LOG_DIR/dmi_probe_reset_access.log
    $RUNSIM dmi_hardreset_clkstop            | tee $LOG_DIR/dmi_hardreset_clkstop.log
    $RUNSIM dmi_hardreset_race               | tee $LOG_DIR/dmi_hardreset_race.log
    $RUNSIM dmi_hardreset_race -dtm cjtag    | tee $LOG_DIR/dmi_hardreset_race_cjtag.log
    $RUNSIM dmi_hardreset_fail_race          | tee $LOG_DIR/dmi_hardreset_fail_race.log
    $RUNSIM dmi_hardreset_fail_race -dtm cjtag | tee $LOG_DIR/dmi_hardreset_fail_race_cjtag.log
    $RUNSIM jtag_pause_long                  | tee $LOG_DIR/jtag_pause_long.log
    $RUNSIM jtag_capture_exit -dtm jtag      | tee $LOG_DIR/jtag_capture_exit.log
    $RUNSIM jtag_capture_exit -dtm cjtag     | tee $LOG_DIR/jtag_capture_exit_cjtag.log
    $RUNSIM jtag_reset_first_edge            | tee $LOG_DIR/jtag_reset_first_edge.log
    $RUNSIM dtm_scan_mode                    | tee $LOG_DIR/dtm_scan_mode.log
    $RUNSIM dmi_sync_reset_width -dtm jtag   | tee $LOG_DIR/dmi_sync_reset_width_jtag.log
    $RUNSIM dmi_sync_reset_width -dtm cjtag  | tee $LOG_DIR/dmi_sync_reset_width_cjtag.log
    $RUNSIM dmi_sync_reset_width -dtm uart   | tee $LOG_DIR/dmi_sync_reset_width_uart.log
    $RUNSIM dmi_sync_reset_width -dtm i2c    | tee $LOG_DIR/dmi_sync_reset_width_i2c.log
    $RUNSIM unselected_pins -dtm jtag        | tee $LOG_DIR/unselected_pins_jtag.log
    $RUNSIM unselected_pins -dtm uart        | tee $LOG_DIR/unselected_pins_uart.log
    $RUNSIM unselected_pins -dtm i2c         | tee $LOG_DIR/unselected_pins_i2c.log
    $RUNSIM unselected_pins -dtm cjtag       | tee $LOG_DIR/unselected_pins_cjtag.log
    # -- UART-specific --
    $RUNSIM uart_dmi_busy                    | tee $LOG_DIR/uart_dmi_busy.log
    $RUNSIM uart_dmi_fail      -dtm uart     | tee $LOG_DIR/uart_dmi_fail.log
    $RUNSIM uart_autobaud                    | tee $LOG_DIR/uart_autobaud.log
    $RUNSIM uart_slow_baud                   | tee $LOG_DIR/uart_slow_baud.log
    $RUNSIM uart_autobaud_glitch             | tee $LOG_DIR/uart_autobaud_glitch.log
    $RUNSIM uart_rx_glitch                   | tee $LOG_DIR/uart_rx_glitch.log
    $RUNSIM uart_start_glitch                | tee $LOG_DIR/uart_start_glitch.log
    $RUNSIM uart_overrun_misframe            | tee $LOG_DIR/uart_overrun_misframe.log
    $RUNSIM uart_autobaud_rearm              | tee $LOG_DIR/uart_autobaud_rearm.log
    $RUNSIM uart_autobaud_holdabort          | tee $LOG_DIR/uart_autobaud_holdabort.log
    $RUNSIM uart_autobaud_break              | tee $LOG_DIR/uart_autobaud_break.log
    $RUNSIM uart_framing                     | tee $LOG_DIR/uart_framing.log
    $RUNSIM uart_drop_misframe               | tee $LOG_DIR/uart_drop_misframe.log
    # -- RX-FIFO request pipelining + DTMSTS status register --
    $RUNSIM uart_pipeline                    | tee $LOG_DIR/uart_pipeline.log
    $RUNSIM uart_poll_nop                    | tee $LOG_DIR/uart_poll_nop.log
    $RUNSIM uart_abort_inflight              | tee $LOG_DIR/uart_abort_inflight.log
    $RUNSIM dtmsts_reg    -dtm uart          | tee $LOG_DIR/dtmsts_reg.log
    $RUNSIM uart_overrun                     | tee $LOG_DIR/uart_overrun.log
    $RUNSIM uart_break_overrun               | tee $LOG_DIR/uart_break_overrun.log
    $RUNSIM uart_baud_ceiling  -dtm uart     | tee $LOG_DIR/uart_baud_ceiling.log
    $RUNSIM uart_meas_wrap     -dtm uart     | tee $LOG_DIR/uart_meas_wrap.log
    $RUNSIM uart_mid_baud      -dtm uart     | tee $LOG_DIR/uart_mid_baud.log
    $RUNSIM uart_divisor_walk  -dtm uart     | tee $LOG_DIR/uart_divisor_walk.log
    $RUNSIM uart_baud_phase                  | tee $LOG_DIR/uart_baud_phase.log
    # -- I2C-specific --
    $RUNSIM i2c_dmi_busy                     | tee $LOG_DIR/i2c_dmi_busy.log
    $RUNSIM i2c_stop_race_wait               | tee $LOG_DIR/i2c_stop_race_wait.log
    $RUNSIM i2c_stop_race_exec               | tee $LOG_DIR/i2c_stop_race_exec.log
    $RUNSIM i2c_abandon_restart              | tee $LOG_DIR/i2c_abandon_restart.log
    $RUNSIM i2c_read_wedge                   | tee $LOG_DIR/i2c_read_wedge.log
    $RUNSIM i2c_abandon_read                 | tee $LOG_DIR/i2c_abandon_read.log
    $RUNSIM i2c_resync_sr_resp               | tee $LOG_DIR/i2c_resync_sr_resp.log
    $RUNSIM i2c_frame_resync                 | tee $LOG_DIR/i2c_frame_resync.log
    $RUNSIM i2c_cold_start                   | tee $LOG_DIR/i2c_cold_start.log
    $RUNSIM i2c_ack_wedge                    | tee $LOG_DIR/i2c_ack_wedge.log
    $RUNSIM i2c_foreign_addr                 | tee $LOG_DIR/i2c_foreign_addr.log
    $RUNSIM i2c_setup_margin                 | tee $LOG_DIR/i2c_setup_margin.log
    $RUNSIM i2c_fast_bus_guards              | tee $LOG_DIR/i2c_fast_bus_guards.log
    $RUNSIM i2c_dtmsts_reg                   | tee $LOG_DIR/i2c_dtmsts_reg.log
    $RUNSIM i2c_poll_after_stop              | tee $LOG_DIR/i2c_poll_after_stop.log
    $RUNSIM i2c_second_request               | tee $LOG_DIR/i2c_second_request.log
    $RUNSIM i2c_stretch_later_byte           | tee $LOG_DIR/i2c_stretch_later_byte.log

    # -- UART at the FPGA's RX FIFO depth (128; the bench default is 32) --
    for t in dmi_rdwr uart_pipeline dtmsts_reg uart_dmi_busy; do
        SIM_EXTRA_DEFINES="UART_FIFO_DEPTH=128" $RUNSIM $t -dtm uart | tee $LOG_DIR/${t}_uart_fifo128.log
    done

    # -- cJTAG at the documented clk_i >= 8x TCKC bound (the default bench runs 16x) --
    for t in dmi_rdwr cjtag_escape_park cjtag_escape_boundary cjtag_por_act cjtag_act_cp_nop \
             cjtag_act_cp_rso cjtag_act_long cjtag_escape_align cjtag_cold_attach \
             cjtag_reset_assert cjtag_first_packet cjtag_bad_actcode cjtag_bad_scnfmt \
             cjtag_escape_5edge dmi_capture_addr dmi_fail_capture_sweep cjtag_escape_inflight \
             dmi_hardreset_race dmi_hardreset_fail_race cjtag_escape_reset_high \
             cjtag_scan_mode cjtag_escape_saturate dmi_walk jtag_capture_exit \
             unselected_pins; do
        SIM_EXTRA_DEFINES="CJHALF=4" $RUNSIM $t -dtm cjtag | tee $LOG_DIR/${t}_cjtag8x.log
    done

    # Report regression results
    ../bin/parse_results $LOG_DIR            | tee $LOG_DIR/../summary.$ii.log

done
